filters:
  and:
    - type == "content"
    - file.inFolder("personal-brand/_obsidian/content/items/blog-posts")
    - list(collections).contains("blog-database")
views:
  - type: kanban-view
    name: Matt Derman Blog
    order:
      - category
      - publish_date
    groupByProperty: status
    columnOrders:
      note.status:
        - idea
        - cogs-are-turning
        - draft
        - planning-scripting
        - scheduled
        - published
        - cancelled
    columnColors:
      note.status:
        idea: yellow
        cogs-are-turning: orange
        draft: blue
        planning-scripting: purple
        scheduled: cyan
        published: green
        cancelled: red
    wrapPropertyValues: false
  - type: table
    name: Matt Derman Blog Table
    order:
      - file.name
      - status
      - category
      - publish_date
      - legacy_thumbnail
    sort:
      - property: status
        direction: ASC
      - property: publish_date
        direction: ASC
